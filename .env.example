# SynTwin AI — optional Generative AI configuration
# The app works without this key using fast local grounded answers.
# For richer natural-language answers, create a Gemini API key in Google AI Studio.

LLM_PROVIDER=gemini
LLM_API_KEY=your_gemini_api_key_here
LLM_MODEL=gemini-2.5-flash-lite

# Alternative name also accepted:
# GEMINI_API_KEY=your_gemini_api_key_here
